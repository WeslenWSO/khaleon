# Desenvolvimento local
DJANGO_SETTINGS_MODULE=khaleon.settings.development
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (produção / Render)
# DATABASE_URL=postgres://user:password@localhost:5432/khaleon

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_RECIPIENT=contato@khaleon.com.br
DEFAULT_FROM_EMAIL=contato@khaleon.com.br

# Conta Azul API (opcional — dashboard usa dados demo sem credenciais)
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=
CONTAAZUL_ACCESS_TOKEN=
